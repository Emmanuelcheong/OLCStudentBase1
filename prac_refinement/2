# Task 2.1
###################################################
import random
secret_code = ""
win = 0

for i in range(3):
    digit = str(random.randint(1, 5))
    secret_code = secret_code + digit

print("Guess the 3-digit number. Each digit is from 1 to 5: ")
print("You have 5 tries. Enter your guess (e.g. 123). ")

for i in range(5):
    guess = input("Enter your guess: ")
    if guess == secret_code:
        print("Congratulations! You guessed the correct number!")
        win = 1
        break
    else:
        correct_digits = 0
        for j in range(3):
            if guess[j] == secret_code[j]:
                correct_digits += 1
        print(f"You have {correct_digits} correct digit(s) in the correct position.")
if win != 1:
    print(f"The secret code is {secret_code}")


















