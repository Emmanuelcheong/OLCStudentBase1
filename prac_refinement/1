ID_list = []
Singaporean = []
entry = int(input("How many entries do you want"))
for i in range(entry):
    while True:
        ID = input("Enter ID: ")
        if len(ID) != 9:
            print("ID must have eaxctly 9 characters")
            continue
        else:
            break
    ID_list.append(ID)
    if ID[0] == "S" or ID[0] == "T":
        print("Welcome home!")
        Singaporean.append(ID)
    else:
        print("Welcome to Singapore!")
print(ID_list)
print(f"There are {len(Singaporean)} Singaporeans")





